# GHAYATH PERSONAL AI — environment template
# Copy to .env and fill real values. NEVER commit a real .env.
# All application settings use the GHAYATH_ prefix.

# ── Database (PostgreSQL) ─────────────────────────────────────────
GHAYATH_DATABASE_URL=postgresql://ghayath:CHANGE_ME@localhost:5432/ghayath
# Optional read-only pool size
GHAYATH_DB_POOL_SIZE=10

# ── Redis (rate limiting / caches) ────────────────────────────────
GHAYATH_REDIS_URL=redis://localhost:6379/0

# ── Auth / JWT ────────────────────────────────────────────────────
# REQUIRED. Long random secret for access tokens (HS256).
GHAYATH_AUTH_JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
GHAYATH_ACCESS_TOKEN_TTL_SECONDS=3600
GHAYATH_REFRESH_TOKEN_TTL_DAYS=7

# Optional one-time bootstrap: creates the OWNER account on startup if absent.
GHAYATH_SEED_OWNER_EMAIL=owner@example.com
GHAYATH_SEED_OWNER_PASSWORD=CHANGE_ME

# ── WhatsApp ──────────────────────────────────────────────────────
# Webhook verification secret (HMAC-SHA256 over raw body). REQUIRED for /webhooks/whatsapp.
GHAYATH_WHATSAPP_WEBHOOK_SECRET=CHANGE_ME
# Comma-separated E.164 sender allow-list (optional but recommended).
GHAYATH_WHATSAPP_ALLOWED_SENDERS=
# Provider (outbound) credentials — from your secret manager in production.
GHAYATH_WHATSAPP_PROVIDER_BASE_URL=
GHAYATH_WHATSAPP_PROVIDER_TOKEN=
# Owner's phone (E.164) — CRITICAL incidents are routed here as WhatsApp alerts.
GHAYATH_NOTIFICATION_WHATSAPP_RECIPIENT=

# ── Email (Gmail/SMTP provider) ───────────────────────────────────
GHAYATH_EMAIL_PROVIDER_BASE_URL=
GHAYATH_EMAIL_PROVIDER_TOKEN=

# ── GitHub ────────────────────────────────────────────────────────
GHAYATH_GITHUB_BASE_URL=https://api.github.com
GHAYATH_GITHUB_TOKEN=

# ── LLM (agent brain) ────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint (OpenAI, OpenRouter,
# Groq, vLLM, Ollama, ...). When GHAYATH_LLM_API_KEY is empty the agent
# brain is honestly unavailable: /agent/command returns 503
# INTEGRATION_OFFLINE instead of falling back to rule-based planning.
GHAYATH_LLM_BASE_URL=https://api.openai.com/v1
GHAYATH_LLM_API_KEY=
GHAYATH_LLM_MODEL=gpt-4o-mini
GHAYATH_LLM_TIMEOUT_SECONDS=60
# Planning budget: max tool steps per plan (over-budget plans are rejected).
GHAYATH_AGENT_MAX_PLAN_STEPS=10

# ── Rate limiting ─────────────────────────────────────────────────
# Contract limits: auth 5/min, agent commands 60/min. Toggle off only in tests.
GHAYATH_RATE_LIMIT_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────
GHAYATH_LOG_LEVEL=INFO

# ── Docker compose (Postgres container) ───────────────────────────
POSTGRES_USER=ghayath
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ghayath
